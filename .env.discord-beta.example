# Template for the Discord beta stack: copy to .env.discord-beta and replace
# every INSERISCI_* placeholder before starting anything.
#
#   Copy-Item .env.discord-beta.example .env.discord-beta
#   notepad .env.discord-beta
#
# The real file is ignored by Git and must never be committed, pasted in a chat
# or copied into an image. These are the credentials of a *separate* Discord
# application: never reuse the production token, client ID or guild.
#
# Naming convention: SAKURA_BETA_* feeds docker-compose.discord-beta.yml, which
# maps the values to the SAKURA_BOT_* names the bot reads.

# ==================================
# Discord beta application (separate app and private test guild)
# ==================================
SAKURA_BETA_DISCORD_TOKEN=INSERISCI_TOKEN_DEL_BOT_BETA
SAKURA_BETA_DISCORD_CLIENT_ID=INSERISCI_APPLICATION_ID_BETA
SAKURA_BETA_TEST_GUILD_ID=INSERISCI_GUILD_ID_DEL_SERVER_BETA
# Optional: leave empty when unused.
SAKURA_BETA_OWNER_ID=
SAKURA_BETA_PREFIX=!

# ==================================
# Beta PostgreSQL (own volume, own credentials)
# ==================================
# Same major as the production cluster in .env.example.
SAKURA_BETA_POSTGRES_VERSION=17-alpine
SAKURA_BETA_POSTGRES_DB=sakura_discord_beta
SAKURA_BETA_POSTGRES_USER=sakura_beta
# Alphanumeric only: the password is embedded in the SQLAlchemy URL without
# escaping, so @ : / or # would break the parsing.
SAKURA_BETA_POSTGRES_PASSWORD=CAMBIA_CON_PASSWORD_TEST_ALFANUMERICA
SAKURA_BETA_POSTGRES_MEM_LIMIT=768m

# ==================================
# Beta Redis (own cache, no persistence)
# ==================================
SAKURA_BETA_REDIS_VERSION=7-alpine
SAKURA_BETA_REDIS_MEM_LIMIT=64m

# ==================================
# Beta bot
# ==================================
SAKURA_BETA_BOT_MEM_LIMIT=512m
SAKURA_BETA_LOG_LEVEL=INFO

# ==================================
# AI provider
# ==================================
# stub: deterministic answers computed inside the process, no network call.
# openai: real provider, allowed only with a dedicated beta key.
SAKURA_BETA_AI_PROVIDER=stub
# Ignored by the stub provider; the placeholder keeps the settings validation
# satisfied without exposing a real key.
SAKURA_BETA_OPENAI_API_KEY=beta-stub-no-network
