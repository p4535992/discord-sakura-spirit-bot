# Template: copy to .env and replace every CHANGE_ME value before starting.
# The same file feeds both the application (when run on the host) and the
# Docker Compose interpolation.
#
#   cp .env.example .env
#   docker compose up -d --build
#
# Never commit the resulting .env: it is already listed in .gitignore.

# ==================================
# GLOBAL
# ==================================
ENVIRONMENT=development
LOG_LEVEL=INFO

# ==================================
# DISCORD
# ==================================
DISCORD_TOKEN=CHANGE_ME_DISCORD_BOT_TOKEN
DISCORD_CLIENT_ID=CHANGE_ME_DISCORD_CLIENT_ID
BOT_PREFIX=!
# Optional: leave empty when unused.
BOT_OWNER_ID=

# ==================================
# OPENAI
# ==================================
OPENAI_API_KEY=CHANGE_ME_OPENAI_API_KEY

# ==================================
# POSTGRES (compose service)
# ==================================
POSTGRES_VERSION=17-alpine
POSTGRES_DB=sakura_bot
POSTGRES_USER=sakura
# Use an alphanumeric password: it is embedded in DATABASE_URL without escaping.
POSTGRES_PASSWORD=CHANGE_ME_BEFORE_START
POSTGRES_PORT=5432

# ==================================
# REDIS (compose service)
# ==================================
REDIS_VERSION=7-alpine

# ==================================
# TRAEFIK
# ==================================
TRAEFIK_VERSION=v3.7.19
TRAEFIK_HTTPS_PORT=443

# ==================================
# MEMORY LIMITS
# ==================================
MEM_LIMIT_BOT=512m
MEM_LIMIT_POSTGRES=768m
MEM_LIMIT_REDIS=64m
MEM_LIMIT_PROXY=128m

# ==================================
# BOT RUNNING ON THE HOST (optional)
# ==================================
# docker-compose.yml builds DATABASE_URL and REDIS_URL for the container.
# Uncomment these only when running main.py directly on the host.
#DATABASE_URL=postgresql+asyncpg://sakura:CHANGE_ME_BEFORE_START@localhost:5432/sakura_bot
#REDIS_URL=redis://localhost:6379/0
#CACHE_REQUIRED=false

# ==================================
# TESTS (optional)
# ==================================
# Point at a throwaway database: the integration fixture drops the schema.
#SAKURA_TEST_DATABASE_URL=postgresql+asyncpg://sakura:CHANGE_ME_BEFORE_START@localhost:5432/sakura_test

# ==================================
# FEATURE FLAGS (default: all enabled)
# ==================================
ENABLE_SPIRITS=true
ENABLE_WEATHER=true
ENABLE_SOCIAL=true
ENABLE_GAMING=true
ENABLE_WORLD=true
ENABLE_GACHA=true
ENABLE_EVENTS=true

