# Template: copy to .env and replace every CHANGE_ME value before starting.
# The same file feeds both the application (when run on the host) and the
# Docker Compose interpolation.
#
#   cp .env.example .env
#   docker compose up -d --build
#
# Naming convention: every key is [CONTAINER]_[KEY], so variables stay grouped
# by the container that consumes them:
#   SAKURA_BOT_*      -> sakura-bot             (Discord application)
#   POSTGRES_*        -> sakura-postgres        (database)
#   REDIS_*           -> sakura-redis           (cache)
#   PROXY_*           -> sakura-proxy           (Traefik TLS termination)
#   PROXY_LOGROTATE_* -> sakura-proxy-logrotate (log rotation sidecar)
#
# Never commit the resulting .env: it is already listed in .gitignore.

# ==================================
# SAKURA_BOT (compose service: sakura-bot)
# ==================================
SAKURA_BOT_ENVIRONMENT=development
SAKURA_BOT_LOG_LEVEL=INFO
SAKURA_BOT_DISCORD_TOKEN=CHANGE_ME_DISCORD_TOKEN
SAKURA_BOT_DISCORD_CLIENT_ID=CHANGE_ME_DISCORD_CLIENT_ID
SAKURA_BOT_PREFIX=!
# Optional: leave empty when unused.
SAKURA_BOT_OWNER_ID=
SAKURA_BOT_OPENAI_API_KEY=CHANGE_ME_OPENAI_API_KEY
SAKURA_BOT_MEM_LIMIT=512m

# Feature flags (default: all enabled)
SAKURA_BOT_ENABLE_SPIRITS=true
SAKURA_BOT_ENABLE_WEATHER=true
SAKURA_BOT_ENABLE_SOCIAL=true
SAKURA_BOT_ENABLE_GAMING=true
SAKURA_BOT_ENABLE_WORLD=true
SAKURA_BOT_ENABLE_GACHA=true
SAKURA_BOT_ENABLE_EVENTS=true

# Running the bot on the host (optional): docker-compose.yml builds these two
# URLs for the container. Uncomment only when running main.py directly.
#SAKURA_BOT_DATABASE_URL=postgresql+asyncpg://sakura:CHANGE_ME_BEFORE_START@localhost:5432/sakura_bot
#SAKURA_BOT_REDIS_URL=redis://localhost:6379/0
#SAKURA_BOT_CACHE_REQUIRED=false

# ==================================
# POSTGRES (compose service: sakura-postgres)
# ==================================
POSTGRES_VERSION=17-alpine
POSTGRES_DB=sakura_bot
POSTGRES_USER=sakura
# Use an alphanumeric password: it is embedded in SAKURA_BOT_DATABASE_URL without
# escaping.
POSTGRES_PASSWORD=CHANGE_ME_BEFORE_START
POSTGRES_PORT=5432
POSTGRES_MEM_LIMIT=768m
# Test suite only: point at a throwaway database, the fixture drops the schema.
#POSTGRES_TEST_DATABASE_URL=postgresql+asyncpg://sakura:CHANGE_ME_BEFORE_START@localhost:5432/sakura_test

# ==================================
# REDIS (compose service: sakura-redis)
# ==================================
REDIS_VERSION=7-alpine
REDIS_MEM_LIMIT=64m

# ==================================
# PROXY (compose service: sakura-proxy, Traefik)
# ==================================
PROXY_TRAEFIK_VERSION=v3.7.19
PROXY_HTTPS_PORT=443
PROXY_MEM_LIMIT=128m

# ==================================
# PROXY-LOGROTATE (compose service: sakura-proxy-logrotate)
# ==================================
PROXY_LOGROTATE_MEM_LIMIT=64m

