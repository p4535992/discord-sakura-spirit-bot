# Fake credentials for the isolated local test stack.
#
# Every value below is a placeholder: it cannot authenticate against Discord,
# OpenAI or any other service. docker-compose.sakura-local-test.yml never starts
# the bot, only the test runner.
#
#   docker compose --env-file .env.sakura-local-test -f docker-compose.sakura-local-test.yml config --quiet

# Compose project name: keeps this stack separate from the application one.
SAKURA_LOCAL_TEST_PROJECT_NAME=sakura-spirit-bot-local-test

# Base images. 16.15 is already in the local image cache; this stack needs no
# other image.
SAKURA_POSTGRES_VERSION=16.15

# Throwaway PostgreSQL: dedicated database, dedicated user, password valid only
# inside the internal test network.
SAKURA_TEST_POSTGRES_DB=sakura_test
SAKURA_TEST_POSTGRES_USER=sakura_test
SAKURA_TEST_POSTGRES_PASSWORD=sakura_local_test_pw

# Resource limits for the two test containers.
SAKURA_TEST_POSTGRES_MEM_LIMIT=256m
SAKURA_TEST_RUNNER_MEM_LIMIT=1g

# Fake application credentials: required by core.config at import time, never
# used for a real connection.
SAKURA_BOT_DISCORD_TOKEN=local-test-fake-discord-token
SAKURA_BOT_DISCORD_CLIENT_ID=123456789012345678
SAKURA_BOT_OPENAI_API_KEY=local-test-fake-openai-key
