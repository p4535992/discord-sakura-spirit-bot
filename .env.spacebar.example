# Template for the Spacebar beta stack. Copy to .env.spacebar and fill the
# placeholders. Every value below is a placeholder: none of them is valid.
#
#   Copy-Item .env.spacebar.example .env.spacebar
#
# .env.spacebar is gitignored and must never be committed.

# Local passwords for the beta databases. Use your own values; they must differ
# from the production ones in .env.
SPACEBAR_DB_PASSWORD=change-me-local-spacebar-db
SAKURA_BETA_DB_PASSWORD=change-me-local-beta-db

# Loopback ports of the Spacebar components (host side). Change them only if a
# port is already in use on Windows.
SPACEBAR_GATEWAY_PORT=3001
SPACEBAR_API_PORT=3002
SPACEBAR_CDN_PORT=3003
SAKURA_BETA_HEALTH_PORT=8081

# Spacebar bot credentials, generated by the local Spacebar instance.
# These are NOT Discord tokens and are not valid on discord.com.
# Replace both placeholders after creating the bot inside Spacebar.
SPACEBAR_BOT_TOKEN=not-created-yet
SPACEBAR_BOT_CLIENT_ID=000000000000000000
